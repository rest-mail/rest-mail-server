# rest-mail — application config contract (internal/config).
#
# These are the flat env vars the Go binaries read directly. You only need this
# file for NATIVE / IDE-debugger runs of a binary (e.g. `air`, `go run
# ./cmd/api`): copy to .env and `set -a; . ./.env; set +a` before launching, or
# point your debugger's envFile at it.
#
# The containerized stack does NOT use this file — the Taskfile derives each
# container's env from config/<CONFIG>/manifest.yml (see `task
# instance:render`). Keep the two in sync by hand only if you run natively.
#
# Values below are the code defaults; override as needed.

# ── Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restmail
DB_USER=restmail
DB_PASS=restmail
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=5m
# Destructive migrations opt-in. Read ONLY by `cmd/migrate`. Server boots (api,
# seed) are always additive-only and never issue destructive DML. Set to true for
# a one-time deploy-time run when a migration must collapse legacy data (e.g.
# duplicate linked_accounts before the mailbox_id unique index). Leave unset/false.
# DB_ALLOW_DESTRUCTIVE_MIGRATIONS=false

# ── API server ──────────────────────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
# Code default is info (internal/config). Set to debug for verbose local runs.
LOG_LEVEL=info
ENVIRONMENT=development
API_BASE_URL=http://localhost:8080
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Secrets (required in production; app rejects the dev values there) ───
JWT_SECRET=dev-secret-change-in-production
MASTER_KEY=
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=168h

# ── Gateways (SMTP / IMAP / POP3) ───────────────────────────────────────
GATEWAY_HOSTNAME=localhost
SMTP_PORT_INBOUND=25
SMTP_PORT_SUBMISSION=587
SMTP_PORT_SUBMISSION_TLS=465
IMAP_PORT=143
IMAP_TLS_PORT=993
POP3_PORT=110
POP3_TLS_PORT=995
# Per-gateway Prometheus /metrics endpoint (scraped over the internal network,
# not host-published). Default 9090; set to 0 to disable.
# SMTP_METRICS_PORT=9090
# IMAP_METRICS_PORT=9090
# POP3_METRICS_PORT=9090
# QUEUE_WORKERS=4
# QUEUE_POLL_INTERVAL=5s
# Outbound delivery refuses to dial non-public (loopback/link-local/private/
# metadata) MX or RESTMAIL endpoint addresses to prevent SSRF. Set true ONLY for
# a dev/testbed that delivers between containers on a private network. Implied by
# ENVIRONMENT=development. Leave false in production.
# OUTBOUND_ALLOW_PRIVATE_DESTINATIONS=false

# ── DNS / TLS ───────────────────────────────────────────────────────────
DNS_PROVIDER=dnsmasq
# TLS_CERT_DIR=
# TLS_CERT_PATH=
# TLS_KEY_PATH=
# Trusted front-proxy networks (comma-separated CIDRs). Also gates the HTTP API's
# X-Forwarded-For handling: a forwarded client IP is honored only when the direct
# peer is one of these. Empty by default = trust no proxy, use the real socket peer.
# PROXY_PROTOCOL_TRUSTED_CIDRS=

# ── Internal mTLS (gateway → API machine auth) — off by default ──────────
# When enabled, the API serves ONLY the two tokenless machine routes
# (GET /api/mailboxes, POST /api/v1/messages/deliver) on a dedicated listener
# that REQUIRES a client certificate signed by the internal CA, and removes them
# from the public listener. Routing is PER-ENDPOINT: those two calls go to
# API_INTERNAL_BASE_URL; API_BASE_URL stays pointed at the PUBLIC listener for
# Login and all token-authenticated user routes (do NOT repoint API_BASE_URL, or
# IMAP/POP3 retrieval and SMTP submission break).
# Mint the certs with:  go run ./cmd/certgen --internal-mtls --out /certs \
#   --server-ip <api-ip> --server-dns api,localhost
# Leave INTERNAL_MTLS_ENABLED=false to keep today's network-trust behavior.
INTERNAL_MTLS_ENABLED=false
# INTERNAL_MTLS_PORT=8443
# API side (cmd/api):
# INTERNAL_MTLS_CA_CERT=/certs/internal-ca.crt
# INTERNAL_MTLS_SERVER_CERT=/certs/internal-server.crt
# INTERNAL_MTLS_SERVER_KEY=/certs/internal-server.key
# Gateway side (smtp/imap/pop3 gateways): API_BASE_URL stays public,
# API_INTERNAL_BASE_URL points at the internal mTLS listener.
# API_INTERNAL_BASE_URL=https://api:8443
# INTERNAL_MTLS_CLIENT_CERT=/certs/internal-client.crt
# INTERNAL_MTLS_CLIENT_KEY=/certs/internal-client.key

# ── ACME (Let's Encrypt) — off by default ───────────────────────────────
ACME_ENABLED=false
# ACME_EMAIL=
# ACME_STAGING=false
# ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
