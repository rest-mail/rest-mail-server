#!/usr/bin/env bash
# Installs the pinned GoReleaser into a directory and puts it on the job's PATH.
#
#   scripts/ci/install-goreleaser "$RUNNER_TEMP/bin"
#
# This does the download and nothing else. It never runs goreleaser, so a failed
# build is never mistaken for a failed download and is never tried again.
#
# goreleaser-action's own download gives up after about 20 seconds. GitHub answered
# `Unexpected HTTP response: 504` for longer than that on 2026-11-09 (Release CLI run
# 42582420200), which failed the snapshot build before GoReleaser started (#1942).
# This keeps trying for longer, and checks what it got against a checksum kept here.
#
# The version is the one `version: "~> v2"` chose in that run: the newest 2.x release.
# To move it, change VERSION and every checksum below together, from the release's
# checksums.txt.
set -euo pipefail

VERSION=2.20.0
BASE_URL=https://github.com/goreleaser/goreleaser/releases/download

directory=${1:?usage: install-goreleaser DIRECTORY}

if [ -n "${INSTALL_GORELEASER_ARCHIVE:-}" ]; then
  name=$INSTALL_GORELEASER_ARCHIVE
  expected=${INSTALL_GORELEASER_SHA256:?INSTALL_GORELEASER_ARCHIVE needs INSTALL_GORELEASER_SHA256}
else
  case "$(uname -s)/$(uname -m)" in
    Linux/x86_64)
      name=goreleaser_Linux_x86_64.tar.gz
      expected=d2483159e6007f814132cb56635ad30a70013dbeb813d6033a7e01adf6ae108c ;;
    Linux/aarch64 | Linux/arm64)
      name=goreleaser_Linux_arm64.tar.gz
      expected=2dada0a6bbcd10f3a05228d98e77d25fb362efb9e5bab6362cf37e64c8a26cb9 ;;
    Darwin/x86_64)
      name=goreleaser_Darwin_x86_64.tar.gz
      expected=a1dfe9492c67b860129bc08fa5952955f0666abe4741e1846f93a6c6b47360e6 ;;
    Darwin/arm64)
      name=goreleaser_Darwin_arm64.tar.gz
      expected=50bd83a6fcbf1dac272cfc4c46f9116052a9b0b463404a044af71a832fd92ad6 ;;
    *)
      echo "goreleaser: no pinned archive for $(uname -s)/$(uname -m)" >&2
      exit 1 ;;
  esac
  expected=${INSTALL_GORELEASER_SHA256:-$expected}
fi
url="${INSTALL_GORELEASER_BASE_URL:-$BASE_URL}/v$VERSION/$name"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
archive="$work/$name"

if ! curl --fail --silent --show-error --location \
  --connect-timeout 30 --max-time 120 \
  --retry "${INSTALL_GORELEASER_RETRIES:-6}" --retry-all-errors --retry-delay "${INSTALL_GORELEASER_RETRY_DELAY:-20}" \
  --output "$archive" "$url"; then
  echo "goreleaser: release download failed; trying GitHub asset API" >&2
  python3 "$(dirname "$0")/github_release.py" "$url" "$archive"
fi

actual=$(shasum -a 256 "$archive" | cut -d' ' -f1)
if [ "$actual" != "$expected" ]; then
  echo "goreleaser $VERSION: checksum $actual, expected $expected" >&2
  exit 1
fi

mkdir -p "$directory"
tar -xzf "$archive" -C "$directory" goreleaser
if [ -n "${GITHUB_PATH:-}" ]; then
  (cd "$directory" && pwd) >>"$GITHUB_PATH"
fi
