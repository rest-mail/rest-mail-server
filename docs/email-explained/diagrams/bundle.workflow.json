{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "visual_preset": "editorial",
    "title": "One message through a packaged mail server, and the configuration behind each step",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "docs/email-explained/diagrams/bundle.html",
    "legend": {
      "entries": {
        "backend": {
          "label": "A daemon in the bundle"
        },
        "security": {
          "label": "Checks, through milters"
        },
        "database": {
          "label": "Mail storage"
        },
        "frontend": {
          "label": "Configuration each one reads"
        },
        "external": {
          "label": "The bundle's own layer"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "flow",
      "label": "The message's path"
    },
    {
      "id": "config",
      "label": "Each step's configuration, still there"
    },
    {
      "id": "bundle",
      "label": "What the bundle adds on top"
    }
  ],
  "mainPath": [
    "internet",
    "postscreen",
    "smtpd",
    "milters",
    "lmtp",
    "maildir"
  ],
  "nodes": [
    {
      "id": "internet",
      "lane": "flow",
      "col": 0,
      "type": "external",
      "label": "Port 25",
      "sublabel": "from the internet"
    },
    {
      "id": "postscreen",
      "lane": "flow",
      "col": 1,
      "type": "backend",
      "label": "postscreen",
      "sublabel": "Postfix: bots, blocklists"
    },
    {
      "id": "smtpd",
      "lane": "flow",
      "col": 2,
      "type": "backend",
      "label": "smtpd, cleanup",
      "sublabel": "Postfix: relay rules"
    },
    {
      "id": "milters",
      "lane": "flow",
      "col": 3,
      "type": "security",
      "label": "Milters",
      "sublabel": "Rspamd, OpenDKIM, OpenDMARC"
    },
    {
      "id": "lmtp",
      "lane": "flow",
      "col": 4,
      "type": "backend",
      "label": "Dovecot",
      "sublabel": "LMTP delivery, Sieve rules"
    },
    {
      "id": "maildir",
      "lane": "flow",
      "col": 5,
      "type": "database",
      "label": "Mailbox",
      "sublabel": "Maildir on a volume"
    },
    {
      "id": "maincf",
      "lane": "config",
      "col": 1,
