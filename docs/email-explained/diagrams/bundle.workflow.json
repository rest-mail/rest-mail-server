  "cards": [
    {
      "dot": "cyan",
      "title": "What packaging solves",
      "items": [
        "Installation in an afternoon",
        "Known-good defaults, connected the same way every time",
        "Upgrades of every component together"
      ]
    },
    {
      "dot": "amber",
      "title": "What stays the same",
      "items": [
        "Every daemon and its configuration language",
        "Debugging means knowing each component and its logs",
        "Containers can add traps: trusted Docker networks, hidden client addresses"
      ]
    }
  ]
}
