      "from": "maincf",
      "to": "postscreen",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "c2",
      "from": "rspamdconf",
      "to": "milters",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "c3",
      "from": "dovecotconf",
      "to": "lmtp",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "g1",
      "from": "env",
