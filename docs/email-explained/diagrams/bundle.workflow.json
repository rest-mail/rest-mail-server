    {
      "id": "g2",
      "from": "ui",
      "to": "rspamdconf",
      "label": "writes",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "g3",
      "from": "images",
      "to": "dovecotconf",
      "label": "ships",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "e6",
      "from": "lmtp",
      "to": "maildir",
      "role": "main",
      "variant": "emphasis"
    }
