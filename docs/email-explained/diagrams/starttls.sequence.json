  "cards": [
    {
      "dot": "rose",
      "title": "What STARTTLS alone protects against",
      "items": [
        "Someone who can only listen: yes",
        "Someone who can change traffic: no; they can delete the offer, or answer with their own certificate"
      ]
    },
    {
      "dot": "cyan",
      "title": "What closes the gap",
      "items": [
        "MTA-STS: the domain publishes over HTTPS that it requires TLS, and with which MX names",
        "DANE: the MX's certificate is published in DNSSEC-signed DNS"
      ]
    },
    {
      "dot": "amber",
      "title": "Between apps and servers",
      "items": [
        "Use implicit TLS: 465, 993, 995 (RFC 8314)",
        "There is no offer to delete when TLS starts with the first byte"
      ]
    }
  ],
