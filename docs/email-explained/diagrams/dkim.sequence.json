  "cards": [
    {
      "dot": "cyan",
      "title": "What a pass proves",
      "items": [
        "The domain in d= signed it",
        "Nothing signed changed since",
        "Not that d= is the From: domain: that is DMARC's check"
      ]
    },
    {
      "dot": "rose",
      "title": "What breaks it",
      "items": [
        "List footers and subject tags",
        "Disclaimers added by gateways",
        "Re-encoding the body on a 7-bit hop",
        "A selector deleted while mail is in transit"
      ]
    },
    {
      "dot": "amber",
      "title": "Keys (RFC 8301, M3AAWG)",
      "items": [
        "RSA 2048 bits, or Ed25519; never rsa-sha1",
        "Rotate at least every six months, with a new selector"
      ]
    }
  ],
  "segments": [
