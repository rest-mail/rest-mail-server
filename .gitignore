# Build output
build/
*.exe
*.exe~
*.dll
*.so
*.dylib
/smtp-gateway
/imap-gateway
/pop3-gateway
/console
/instantmailcheck
/seed

# Go test binary
*.test

# Go coverage
*.out
coverage.html

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
.env.production

# Instance domain dirs end in ".test", which the "*.test" rule above would
# otherwise ignore whole — re-include instance dirs so manifests/config commit...
!instances/*.test/
# ...but never commit per-instance secrets.
instances/*/secrets.env

# Docker volumes (local dev)
postgres-data/

# Node modules (webmail)
webmail/node_modules/
webmail/dist/

# Generated certs (local)
certs/
!docker/certs/

# OS files
.DS_Store
Thumbs.db
.task/checksum
.history
.claude

# Local-dev workspace (cloned peer repos: testbed, reference-mailserver)
.workspace/
.claude/workgroup/
