# Build output
build/
*.exe
*.exe~
*.dll
*.so
*.dylib
/smtp-gateway
/imap-gateway
/pop3-gateway
/console
/instantmailcheck
/seed

# Go test binary
*.test

# Go coverage
*.out
coverage.html

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
.env.production

# Instance domain dirs end in ".test", which the "*.test" rule above would
# otherwise ignore whole — re-include instance dirs so manifests/config commit...
!config/*.test/
# ...except restmail.test, which `chore testbed:init` seeds by copying the
# testbed's fixture config. The testbed repo owns that fixture; the copy here is
# local runtime state, so it must never be committed. Re-run testbed:init to
# restore it.
config/restmail.test
# ...and never commit per-instance secrets or generated dns.env.
config/*/secrets.env
config/*/dns.env
config/*/dkim.conf

# chore's fingerprint cache, how it decides whether a task's sources changed.
.chore/

# `go build ./cmd/instance` with no -o leaves an 11MB binary here, named after the
# package. Anchored to the repository root so it cannot match the config/<domain>/
# instance directories re-included above.
/instance

# Docker volumes (local dev)
postgres-data/

# Node modules (webmail)
webmail/node_modules/
webmail/dist/

# Generated certs (local)
certs/
!docker/certs/

# OS files
.DS_Store
Thumbs.db
.task/checksum
.history
.claude
.pnpm-store

# Local-dev workspace (cloned peer repos: testbed, reference-mailserver)
.workspace/
.claude/workgroup/
.cache/
