# The rate limits the E2E topology's API runs with during the contract phases
# only (#1979): examples, coverage, authorization and ownership. Read by the
# API from its environment (internal/config/config.go), so no code path exists
# for the test alone. The Limits suite proves the real defaults on an API
# recreated without this file; tests/contract/rate_limits.py checks both, and
# its CONTRACT_RAISED_LIMITS switch is what turns the hooks' pacing off.
# The owner routes share login's rate (AUTH_RATE_LIMIT_*) in a bucket of their own.
AUTH_RATE_LIMIT_RPS=1000
AUTH_RATE_LIMIT_BURST=1000
PIPELINE_TEST_RATE_LIMIT_RPS=1000
PIPELINE_TEST_RATE_LIMIT_BURST=1000
TLSRPT_RATE_LIMIT_RPS=1000
TLSRPT_RATE_LIMIT_BURST=1000
